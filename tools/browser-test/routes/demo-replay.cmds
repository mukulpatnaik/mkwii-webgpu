# Demo capture "replay" (tools/video/capture.sh replay): the same start as demo-boot (Start, the
# controls panel hidden, the opening), then title -> licence 1 -> Single Player -> Time Trials ->
# default character, kart and drift -> Mushroom Cup -> Luigi Circuit -> Ghosts -> "Watch the
# Replay": the disc's staff ghost (1:29.670, the parity harness's reference run,
# scripts/parity/rkg-info.py) drives its three laps. Nobody drives, so the footage is a perfect lap
# rendered live. Marks: page, start, title, main-menu, ghosts, replay (the final A press; the
# replay starts a few seconds later).
#
# Needs a licence in slot 1: the site's game folder seeds a save (tools/hosting/stage-game.sh
# --save rksys.dat; one exported from any run with the page's Export save button will do).
#
# Left click is A, and every press counts: one press too many or too few and the D-pad presses
# land on the wrong screens (the route then races a Grand Prix or a ghost with nobody driving).
# A D-pad press is also lost when it arrives before a menu has slid in; the Single Player menu is
# the slowest (black for ~2 s, ready at ~5 s on an idle machine), so it gets 8 s.
mark page
waitstart 90000
mark start
wait 2500
eval document.getElementById('hide-controls').click()
# The title scene: the game's THP library announces itself as it starts (the first such line).
# Counting from Start instead put the route one press off whenever the boot took a little more or
# less time (the attract demo it meant to skip had not started yet).
waitlog 120 RVL_SDK - THP
mark title
wait 3000
# title -> Select License (licence 1 under the cursor) -> main menu
click 500 430
wait 3000
click 500 430
wait 4500
mark main-menu
# Single Player, then down to Time Trials
click 500 430
wait 8000
key ArrowDown 150
wait 1500
shot single-player
click 500 430
wait 4500
# character -> kart -> drift -> Mushroom Cup -> Luigi Circuit -> Ghosts screen
click 500 430
wait 4500
click 500 430
wait 4500
click 500 430
wait 4500
click 500 430
wait 4500
click 500 430
wait 8000
mark ghosts
key ArrowDown 150
wait 1500
shot ghosts
# "Watch the Replay" -> Start Race: OK
click 500 430
wait 4500
mark replay
click 500 430
# the replay: about 8 s of loading and camera, then the ghost's 1:29.670 run
wait 30000
wait 30000
wait 30000
wait 20000
mark end
wait 500
