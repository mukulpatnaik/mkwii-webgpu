# Upstream checkouts (clone with scripts/clone-upstream.sh); never commit them here.
/upstream/
# Build output
/build/
/build-*/
/spikes/*/out/
# Never commit anything derived from a game dump.
*.iso
*.wbfs
*.rvz
*.gcm
*.ciso
*.dol
*.rel
/generated/
*.gcz
*.wia
# User game dump and anything derived from it
/game/
# Builds, staged sites, release directories and track worktrees. The one tracked thing under
# work/ is the engine, a submodule (.gitmodules): the fork of WiiCompiled, its own git repository.
/work/*
!/work/Wiicompiled
__pycache__/
# Demo video (video/README.md): captures and renders show the game; node_modules is installed.
/video/public/captures/
/video/out/
/video/node_modules/
