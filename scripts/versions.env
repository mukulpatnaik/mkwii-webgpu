# Pinned tool versions for this project: the one place to change them. Sourced by
# scripts/doctor.sh; .github/workflows/checks.yml (this repo) and the fork's
# .github/workflows/web-checks.yml (work/Wiicompiled) copy the same values by hand, so a change
# here means changing those two files too. Recorded on 2026-10-28 from the machine that built and
# tested the release (docs/release-checklist.md).
#
# "Required" tools stop doctor.sh with an error when missing; the others only warn.

# Emscripten (required): the web build and the wasm unit tests. ~/tools/emsdk, `source emsdk_env.sh`.
EMSDK_VERSION=6.0.11
EMSDK_DIR="${EMSDK:-$HOME/tools/emsdk}"

# .NET SDK (required): the translator. ~/tools/dotnet (dotnet-install.sh --channel 8.0).
DOTNET_VERSION=8.0.425
DOTNET_DIR="${DOTNET_ROOT:-$HOME/tools/dotnet}"

# Node (required): Emscripten's runner, the Node tests, the browser tests, the local server builds.
NODE_MAJOR=24
NODE_VERSION=24.14.0

# Clang (required for the native build only): clang-16 cannot compile aurora's pad.cpp against
# GCC 15's libstdc++ on Ubuntu 26.04 (docs/parity-ntsc-u.md), so the native build uses 18.
CLANG_MAJOR=18
CLANG_VERSION=18.1.8

# CMake and Ninja (required). ~/tools/bin/ninja is the working binary; the ~/.local/bin/ninja
# shim is broken, so ~/tools/bin must come first on PATH.
CMAKE_MIN=3.16
CMAKE_VERSION=4.2.3
NINJA_VERSION=1.13.2

# Rust (required): the disc reader (nod for wasm32), built by the web build and in CI.
RUST_CHANNEL=stable
RUST_VERSION=1.97.0
RUST_WASM_TARGET=wasm32-unknown-unknown

# nodtool (required for extraction): the nod CLI that extracts the disc for the translator.
# ~/tools/bin/nodtool; the git revision is the one the disc-wasm crates pin too.
NODTOOL_VERSION=2.0.0-alpha.12
NOD_REV=ebd80cac99b48a323200d84365e07a58cc27412d

# Google Chrome (required to test): JSPI and WebGPU need 137 or newer.
CHROME_MIN=137
CHROME_VERSION=156

# Bun (optional): builds the one-file local server, tools/web-server.
BUN_VERSION=1.4.2

# Python 3 (required): staging, menu-video conversion, test helpers.
PYTHON_MIN=3.10
PYTHON_VERSION=3.14.4

# SDL's Linux backends, for the native build on Ubuntu 26.04 (docs/parity-ntsc-u.md).
SDL_APT_PACKAGES="libdbus-1-dev libxcursor-dev libxrandr-dev libxtst-dev libxss-dev libibus-1.0-dev libwayland-dev wayland-protocols libdecor-0-dev libpipewire-0.3-dev libpulse-dev libsndio-dev liburing-dev libudev-dev libegl-dev libgbm-dev libdrm-dev libxkbcommon-x11-dev libusb-1.0-0-dev libsamplerate0-dev"
